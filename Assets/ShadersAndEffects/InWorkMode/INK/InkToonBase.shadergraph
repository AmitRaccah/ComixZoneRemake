{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "eef08683c5a84baf96e01fd4af17ec0e",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "InkDripMask (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 1910.9998779296875,
            "y": 2345.0,
            "width": 225.0001220703125,
            "height": 470.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "d2f39f5fea0147c3a9530b92a4f27e64"
        },
        {
            "m_Id": "5112a39605434188a579fd265822468b"
        },
        {
            "m_Id": "fef3824b24b647a1ad706e910b411834"
        },
        {
            "m_Id": "d0d1d41fd26349868e106c6078a3dccb"
        },
        {
            "m_Id": "3d54b6ae90bd401d91dd30a373ad6a2c"
        },
        {
            "m_Id": "0f2bcb0f394649e38e08b4788fc6ddf2"
        },
        {
            "m_Id": "e68a42f030434638848f839d6131706a"
        },
        {
            "m_Id": "d8b7ec81bd4046ea978989cf96d88ff9"
        },
        {
            "m_Id": "4637ca022862494c822553e74c913382"
        },
        {
            "m_Id": "920e60af990842d187a45b359fdf4807"
        },
        {
            "m_Id": "7000c9df45144bfbb86c7231948701b5"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 0,
    "m_FunctionName": "InkDripMask",
    "m_FunctionSource": "cacbde94c540e2f49a3fd5ac34f86072",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "void InkDripMask_float(\r\n    float3 posWS,\r\n    float  YBase,\r\n    float  YHeight,\r\n    float  DripSpeed,\r\n    float  TrailWidth,\r\n    float  DripDensity,\r\n    float  DropSize,\r\n    float  NoiseScale,\r\n    Texture2D NoiseTex,\r\n    SamplerState NoiseTex_sampler,\n    float Time,\r\n    out float mask)\r\n{\r\n     float y01 = saturate((posWS.y - YBase) / max(YHeight, 1e-5));\n\n    // Horizontal band centered at 0.5\n    float halfW = max(TrailWidth * 0.5, 1e-5);\n    float band  = 1.0 - smoothstep(0.5 - halfW, 0.5 + halfW, abs(y01 - 0.5));\n\n    // Animated noise in XZ\n    float2 uv = posWS.xz * NoiseScale;\n    float  t  = Time * DripSpeed; // <-- Changed _Time.y to just 'Time'\n    float  n  = SAMPLE_TEXTURE2D(NoiseTex, NoiseTex_sampler, uv + t).r;\r\n\r\n    // Column gating (simple)\r\n    float cells   = max(DripDensity, 1.0);\r\n    float gx      = frac(uv.x * cells);\r\n    float columns = step(1.0 - saturate(cells * 0.1), gx + n * 0.5);\r\n\r\n    // Head blob near top of band\r\n    float head = smoothstep(0.0, DropSize, y01) * (1.0 - y01);\r\n\r\n    mask = saturate(band * max(columns, head));\r\n}\r\n"
}

